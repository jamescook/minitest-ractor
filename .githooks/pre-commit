#!/usr/bin/env bash
# Reject staged content that references something this repository does not contain.
#
# docs/adr/ and .beads/ are both listed in .git/info/exclude, so they exist on one machine and
# nowhere else. A comment pointing at "docs/adr/0001", or at a bead id, is a dangling reference
# for every other reader — and dangling silently, since nothing fails when the target is simply
# absent. Hence a mechanical check rather than a rule people remember.
#
# Wired with: git config core.hooksPath .githooks
set -euo pipefail

hook_dir=".githooks"
bead_prefix="ractortest"     # matches .beads/ ids; bd's default prefix is the repo dir name
adr_pattern='docs/adr/[0-9]'
bead_pattern="\\b${bead_prefix}-[a-z0-9]+(\\.[0-9]+)*\\b"

status=0

report() {
  local file="$1" what="$2" hits="$3"
  echo "error: $file references $what, which is not in this repository:" >&2
  echo "$hits" | sed 's/^/  /' >&2
  status=1
}

while IFS= read -r file; do
  # The hook itself has to name the patterns it bans.
  case "$file" in
    "$hook_dir"/*) continue ;;
  esac

  # Read the STAGED blob, not the working tree — they can differ.
  content="$(git show ":$file" 2>/dev/null)" || continue

  if hits="$(printf '%s' "$content" | grep -nE "$adr_pattern")"; then
    report "$file" "an architecture decision record" "$hits"
  fi

  if hits="$(printf '%s' "$content" | grep -nEi "$bead_pattern")"; then
    report "$file" "a bead id" "$hits"
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "Put the reasoning in the code or the comment itself rather than pointing at a file" >&2
  echo "nobody else has. To bypass once: git commit --no-verify" >&2
fi

exit "$status"
